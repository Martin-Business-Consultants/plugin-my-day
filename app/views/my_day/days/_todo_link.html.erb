<%# locals: (todo:, current:, number: nil) %>
<%# One piece of work in the list or the priorities: its number (in the priorities), its state
    (the dot, which a box takes over to pick it for the bulk bar, x), its title with the client
    under it, its engagement's ref and when it's due. j / k move through the rows (the core's
    keyboard controller), Enter or o opens one on the right; drag it onto Priorities (or back off). %>
<div class="<%= class_names("my-day-row", "my-day-row--current": current, "my-day-row--done": todo.status == "done", "my-day-row--waiting": todo.status.in?(MyDay::Day::WAITING)) %>" draggable="true"
     data-id="<%= todo.id %>" data-drag-and-drop-target="item" data-filter-target="item">
  <% if number %>
    <span class="my-day-number"><%= number %></span>
  <% end %>
  <span class="my-day-row__mark">
    <%= my_day_marker todo %>
    <input type="checkbox" class="checkbox my-day-row__check" value="<%= todo.id %>" aria-label="Pick <%= todo.title %>"
           data-bulk-target="item" data-action="bulk#update" data-keys="x">
  </span>
  <%= link_to my_day_open_path(todo), class: "my-day-link", draggable: false,
        title: "#{todo.title} · #{todo.engagement.ref} #{todo.engagement.title}",
        aria: { current: ("page" if current) }, data: { turbo_action: "replace" } do %>
    <span class="my-day-link__text">
      <span class="my-day-link__title"><%= todo.title %></span>
      <span class="my-day-link__client"><%= todo.client.name %></span>
    </span>
    <span class="my-day-link__ref"><%= todo.engagement.ref %></span>
    <%= my_day_due todo %>
  <% end %>
</div>
