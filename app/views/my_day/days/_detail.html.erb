<%# locals: (day:, todo:) %>
<%# The piece of work picked on the left: where it's from, its status in one click, its details,
    and its place in your priorities. Its notes follow in a panel of their own. %>
<% priority_todos = day.priority_todos %>
<% place = priority_todos.index(todo) %>
<article class="settings__panel panel shadow txt-align-start my-day-card">
  <header class="my-day-card__header">
    <p class="txt-x-small txt-subtle margin-none overflow-ellipsis">
      <%= link_to "#{todo.engagement.ref} #{todo.engagement.title}", todo.engagement, class: "txt-link" %>
      · <%= link_to todo.client.name, todo.client, class: "txt-link" %>
    </p>
    <div class="my-day-card__heading">
      <h2 class="my-day-card__title"><%= todo.title %></h2>
      <%= status_tag my_day_status_label(todo) %>
    </div>
    <div class="my-day-card__facts txt-small txt-subtle">
      <% if todo.due_on %>
        <span>Due <%= my_day_due todo %></span>
      <% else %>
        <span>No due date</span>
      <% end %>
      <span class="my-day-owners">
        <% todo.owners.each do |owner| %>
          <%# herb:key owner.id %>
          <%= person_tag owner %>
        <% end %>
      </span>
    </div>
  </header>

  <div class="my-day-statuses" role="group" aria-label="Status">
    <% MyDay::DaysHelper::STATUS_LABELS.each do |status, label| %>
      <%# herb:key status %>
      <%= button_to label, my_day_todo_status_path(todo), method: :patch, params: my_day_return_params.merge(status: status),
            class: "btn", aria: { pressed: todo.status == status } %>
    <% end %>
  </div>

  <% if todo.description.present? %>
    <div class="my-day-card__description txt-small"><%= rich_text todo.description %></div>
  <% end %>

  <footer class="my-day-card__footer">
    <% if place %>
      <span class="my-day-card__priority txt-small">
        <%= icon_tag "pinned" %> Priority <%= place + 1 %> of <%= priority_todos.size %>
      </span>
      <% if place.positive? %>
        <%= button_to my_day_priority_path(todo), method: :patch, params: my_day_return_params.merge(direction: "up"),
              class: "btn btn--circle", title: "Move up" do %>
          <%= icon_tag "arrow-up" %> <span class="for-screen-reader">Move up</span>
        <% end %>
      <% end %>
      <% if place < priority_todos.size - 1 %>
        <%= button_to my_day_priority_path(todo), method: :patch, params: my_day_return_params.merge(direction: "down"),
              class: "btn btn--circle my-day-down", title: "Move down" do %>
          <%= icon_tag "arrow-up" %> <span class="for-screen-reader">Move down</span>
        <% end %>
      <% end %>
      <%= button_to my_day_priority_path(todo), method: :delete, params: my_day_return_params,
            class: "btn" do %>
        <%= icon_tag "unpinned" %> <span>Remove</span>
      <% end %>
    <% else %>
      <%= button_to my_day_priority_path(todo), method: :post, params: my_day_return_params,
            class: "btn" do %>
        <%= icon_tag "pinned" %> <span>Add to priorities</span>
      <% end %>
    <% end %>
    <%= link_to todo, class: "btn my-day-card__open" do %>
      <span>Open in <%= term(:work) %></span> <%= icon_tag "arrow-right" %>
    <% end %>
  </footer>
</article>

<div class="settings__panel panel shadow txt-align-start my-day-notes">
  <%= render "notes/section", subject: todo, permanent: false %>
</div>
