<%# locals: (day:, todo:, open: nil) %>
<%# Your work on the left, the piece you picked on the right. Picking one, searching or changing
    something reloads the page in place (Turbo's morphing refresh, scroll kept: the core's way,
    which Lexxy's editor in the notes needs); the search box is kept as you type. Work is dragged
    onto Priorities to add it (or within them to reorder) and back onto the list to take it off:
    the core's drag-and-drop controller, whose answer refreshes the page. Priorities unfold when
    the piece on the right is one of them, when there are none yet (the drop area), and after a
    change to them (open). %>
<% back = { show: params[:show], q: params[:q], todo: todo&.id }.compact_blank %>
<% priority_todos = day.priority_todos %>
<div id="my_day">
  <section class="settings settings--split my-day-split">
    <div class="settings__panel panel shadow txt-align-start flex flex-column gap"
         data-controller="drag-and-drop"
         data-drag-and-drop-dragged-item-class="drag-and-drop__dragged-item"
         data-drag-and-drop-hover-container-class="drag-and-drop__hover-container"
         data-action="dragstart->drag-and-drop#dragStart dragover->drag-and-drop#dragOver drop->drag-and-drop#drop dragend->drag-and-drop#dragEnd">
      <div class="page-heading">
        <h1 class="page-title">My day</h1>
        <span class="txt-small txt-subtle"><%= Date.current.strftime("%A, %-d %B") %></span>
      </div>

      <div class="my-day-tools">
        <%= form_with url: my_day_day_path, method: :get, class: "my-day-search", data: { controller: "form", turbo_action: "replace" } do |form| %>
          <%= hidden_field_tag :show, day.show, id: nil %>
          <label class="input my-day-search__box">
            <%= icon_tag "search" %>
            <%= form.search_field :q, value: day.query, id: "my_day_search", class: "full-width", placeholder: "Search your work…",
                  autocomplete: "off", aria: { label: "Search your work" }, data: { turbo_permanent: true, action: "input->form#debouncedSubmit" } %>
          </label>
        <% end %>
        <%= render "layouts/shared/quick_filter", title: "Show…", param: :show, current: day.show, options: MyDay::Day::SHOWS.invert.to_a %>
      </div>

      <%# Picked rows (x on the row you're on, or its box), acted on together: the core's bulk bar,
          its work actions (Bulk::TodosController) and the priorities' own. %>
      <% keep = my_day_return_params.merge(todo: todo&.id).compact_blank %>
      <%= bulk_bar do %>
        <%= bulk_button my_day_bulk_priorities_path, method: :post, label: "Add to priorities", params: keep %>
        <%= bulk_button my_day_bulk_priorities_path, method: :delete, label: "Take off priorities", params: keep %>
        <%= bulk_menu bulk_todos_path, method: :patch, name: "todo[status]", label: "Status", choices: MyDay::DaysHelper::STATUS_LABELS.invert.to_a %>
        <%= bulk_date bulk_todos_path, method: :patch, name: "todo[due_on]", label: "Due date" %>
        <%= bulk_menu bulk_todos_path, method: :patch, name: "todo[owner_id]", label: "Lead", choices: [ [ "Me", "me" ] ] + User.active.people.ordered.map { [ it.display_name, it.id ] } %>
      <% end %>

      <details class="<%= class_names("my-day-priorities", "my-day-priorities--empty": priority_todos.empty?) %>" <% if open || priority_todos.include?(todo) || priority_todos.empty? %>open<% end %>
               data-drag-and-drop-target="container" data-drag-and-drop-sortable="true"
               data-drag-and-drop-url="<%= my_day_priority_path("__id__", **back) %>">
        <summary class="my-day-priorities__summary">
          <%= icon_tag "caret-down", class: "my-day-priorities__caret" %>
          <%= icon_tag "pinned" %>
          <strong>Priorities</strong>
          <% if priority_todos.any? %>
            <span class="<%= class_names("txt-x-small", "txt-subtle": priority_todos.any? { it.status != "done" }, "my-day-priorities__done": priority_todos.all? { it.status == "done" }) %>"><%= my_day_progress priority_todos %></span>
          <% end %>
          <span class="my-day-priorities__count txt-x-small" title="Priorities hold <%= MyDay::Bundle::LIMIT %>"><%= priority_todos.size %>/<%= MyDay::Bundle::LIMIT %></span>
        </summary>
        <nav class="scope-nav" aria-label="Priorities" data-drag-drop-item-container>
          <% priority_todos.each_with_index do |priority, index| %>
            <%# herb:key "priority-#{priority.id}" %>
            <%= render "my_day/days/todo_link", todo: priority, current: priority == todo, number: index + 1 %>
          <% end %>
        </nav>
        <%# The places still free, numbered on from the work in it: where the next drop lands. %>
        <% free = MyDay::Bundle::LIMIT - priority_todos.size %>
        <% if free.positive? %>
          <ol class="my-day-slots">
            <% free.times do |index| %>
              <%# herb:key "slot-#{index}" %>
              <li class="my-day-slot txt-x-small txt-subtle">
                <span class="my-day-number"><%= priority_todos.size + index + 1 %></span>
                <% if index.zero? %>
                  <span>Drag work here</span>
                <% end %>
              </li>
            <% end %>
          </ol>
        <% end %>
      </details>

      <div class="flex flex-column gap" data-drag-and-drop-target="container" data-drag-and-drop-url="<%= my_day_priority_removal_path("__id__", **back) %>">
        <div data-drag-drop-item-container hidden></div>
        <% day.groups.each do |group| %>
          <%# herb:key group.key %>
          <section class="settings__section flex flex-column gap-half" aria-label="<%= group.title %>">
            <header class="my-day-group__header">
              <h2 class="divider"><%= group.title %></h2>
              <span class="<%= class_names("txt-x-small", "txt-subtle": group.key != "late", "my-day-due--late": group.key == "late") %>"><%= group.todos.size %></span>
            </header>
            <nav class="scope-nav" aria-label="<%= group.title %>">
              <% group.todos.each do |item| %>
                <%# herb:key item.id %>
                <%= render "my_day/days/todo_link", todo: item, current: item == todo && !priority_todos.include?(todo), number: nil %>
              <% end %>
            </nav>
          </section>
        <% end %>
        <% if day.groups.empty? %>
          <p class="txt-small txt-subtle margin-none">
            <% if day.query.present? %>
              Nothing of yours matches “<%= day.query %>”.
            <% elsif day.show == "open" %>
              Nothing open is yours. Work you lead or are on shows here.
            <% else %>
              Nothing here. <%= link_to "Show everything open", my_day_day_path, class: "txt-link" %>
            <% end %>
          </p>
        <% end %>
      </div>
    </div>

    <div id="my_day_detail" class="my-day-detail">
      <% if todo %>
        <%= render "my_day/days/detail", day: day, todo: todo %>
      <% else %>
        <p class="settings__panel panel shadow txt-small txt-subtle margin-none">Nothing to work on. Pick a piece of work on the left when there is.</p>
      <% end %>
    </div>
  </section>
</div>
