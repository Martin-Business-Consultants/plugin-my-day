<% @page_title = "My day" %>
<% day = @day %>

<%# Your work on the left, the piece you picked on the right. Picking one, searching or moving on
    reloads only this frame; the search box is kept as you type. %>
<turbo-frame id="my_day" target="_top">
  <section class="settings settings--split my-day-split">
    <div class="settings__panel panel shadow txt-align-start flex flex-column gap">
      <div class="page-heading">
        <h1 class="page-title"><%= @page_title %></h1>
        <span class="txt-small txt-subtle"><%= Date.current.strftime("%A, %-d %B") %></span>
      </div>

      <div class="my-day-tools">
        <%= form_with url: my_day_day_path, method: :get, class: "my-day-search", data: { controller: "form", turbo_frame: "my_day", turbo_action: "advance" } do |form| %>
        <%= hidden_field_tag :show, day.show, id: nil %>
        <label class="input my-day-search__box">
          <%= icon_tag "search" %>
          <%= form.search_field :q, value: day.query, id: "my_day_search", class: "full-width", placeholder: "Search your work…",
                autocomplete: "off", aria: { label: "Search your work" }, data: { turbo_permanent: true, action: "input->form#debouncedSubmit" } %>
        </label>
      <% end %>

      <%= render "layouts/shared/quick_filter", title: "Show…", param: :show, current: day.show, options: MyDay::Day::SHOWS.invert.to_a %>
      </div>

      <section class="settings__section flex flex-column gap-half" aria-label="Pinned">
        <header class="my-day-group__header">
          <h2 class="divider">Pinned</h2>
        </header>
        <% day.bundles.each do |bundle| %>
          <%# herb:key bundle.id %>
          <% todos = bundle.todos_from(day.pinned_todos) %>
          <details class="my-day-bundle" <% if bundle == @from_bundle || todos.include?(@todo) %>open<% end %>>
            <summary class="my-day-bundle__summary">
              <%= icon_tag "caret-down", class: "my-day-bundle__caret" %>
              <%= icon_tag "pinned" %>
              <strong class="overflow-ellipsis"><%= bundle.name %></strong>
              <span class="<%= class_names("txt-x-small", "txt-subtle": todos.any? { it.status != "done" }, "my-day-bundle__done": todos.any? && todos.all? { it.status == "done" }) %>"><%= my_day_progress todos %></span>
            </summary>
            <% if todos.any? %>
              <nav class="scope-nav" aria-label="<%= bundle.name %>">
                <% todos.each_with_index do |todo, index| %>
                  <%# herb:key "#{bundle.id}-#{todo.id}" %>
                  <%= render "my_day/days/todo_link", todo: todo, bundle: bundle, current: todo == @todo && bundle == @from_bundle, number: index + 1 %>
                <% end %>
              </nav>
            <% else %>
              <p class="txt-x-small txt-subtle margin-none">Nothing pinned yet: open a piece of work and pin it here from the right.</p>
            <% end %>
            <div class="my-day-bundle__actions">
              <details class="my-day-inline">
                <summary class="btn txt-small"><%= icon_tag "pencil" %> <span>Rename</span></summary>
                <%= form_with url: my_day_bundle_path(bundle), method: :patch, scope: :bundle, namespace: dom_id(bundle), class: "flex gap-half", data: { turbo_frame: "my_day" } do |form| %>
                  <%= my_day_return_fields %>
                  <%= form.text_field :name, value: bundle.name, class: "input txt-small", required: true, maxlength: 80, aria: { label: "Name" } %>
                  <button type="submit" class="btn txt-small">Save</button>
                <% end %>
              </details>
              <%= render "layouts/shared/delete_dialog", name: bundle.name, path: my_day_bundle_path(bundle), message: "This unpins its work; the work itself stays as it is." %>
            </div>
          </details>
        <% end %>
        <details class="my-day-inline">
          <summary class="btn txt-small"><%= icon_tag "add" %> <span>New bundle</span></summary>
          <%= form_with url: my_day_bundles_path, scope: :bundle, class: "flex gap-half", data: { turbo_frame: "my_day" } do |form| %>
            <%= my_day_return_fields %>
            <%= form.text_field :name, class: "input txt-small", required: true, maxlength: 80, placeholder: "Before lunch", autofocus: true, aria: { label: "Name" } %>
            <button type="submit" class="btn txt-small">Start</button>
          <% end %>
        </details>
      </section>

      <% day.groups.each do |group| %>
        <%# herb:key group.key %>
        <section class="settings__section flex flex-column gap-half" aria-label="<%= group.title %>">
          <header class="my-day-group__header">
            <h2 class="divider"><%= group.title %></h2>
            <span class="<%= class_names("txt-x-small", "txt-subtle": group.key != "late", "my-day-due--late": group.key == "late") %>"><%= group.todos.size %></span>
          </header>
          <nav class="scope-nav" aria-label="<%= group.title %>">
            <% group.todos.each do |todo| %>
              <%# herb:key todo.id %>
              <%= render "my_day/days/todo_link", todo: todo, bundle: nil, current: todo == @todo && @from_bundle.nil?, number: nil %>
            <% end %>
          </nav>
        </section>
      <% end %>
      <% if day.groups.empty? %>
        <p class="txt-small txt-subtle margin-none">
          <% if day.query.present? %>
            Nothing of yours matches “<%= day.query %>”.
          <% elsif day.show == "open" %>
            Nothing open is yours. Work you lead or are on shows here.
          <% else %>
            Nothing here. <%= link_to "Show everything open", my_day_day_path, class: "txt-link" %>
          <% end %>
        </p>
      <% end %>
    </div>

    <div id="my_day_detail" class="settings__panel panel shadow txt-align-start my-day-detail">
      <% if @todo %>
        <%= render "my_day/days/detail", day: day, todo: @todo, from_bundle: @from_bundle, next_todo: @next %>
      <% else %>
        <p class="txt-small txt-subtle margin-none">Nothing to work on. Pick a piece of work on the left when there is.</p>
      <% end %>
    </div>
  </section>
</turbo-frame>
